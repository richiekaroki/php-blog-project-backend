{
    "name": "vendor/blog-backend",
    "description": "Simple PHP Blog Backend",
    "type": "project",
    "authors": [
        {
            "name": "User"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "migrate": "@php bin/migrate.php",
        "migrate:status": "@php bin/migrate.php --status",
        "test": "phpunit --testdox",
        "stan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix"
    }
}
