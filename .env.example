APP_NAME=Wam Blog Backend
APP_ENV=local
# Required — used to sign magic links (HMAC-SHA256). Generate: base64 32 random bytes.
APP_KEY=
APP_DEBUG=true
# Base URL used to build magic link URLs. For Render: https://<your-service>.onrender.com
APP_URL=http://127.0.0.1
# LOCAL DEV ONLY — silently signs you into the admin area without the magic-link
# email flow. Requires APP_ENV=local AND this exact value; never set in production.
# DEV_AUTOLOGIN=true
# Optional dev account email used by DEV_AUTOLOGIN (defaults to dev@local.test).
# DEV_ADMIN_EMAIL=dev@local.test

# ===== POSTGRESQL SETTINGS (local / Herd) =====
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mizzle_backend
DB_USERNAME=postgres
DB_PASSWORD=
# SSL mode for direct DB_* connections. 'prefer' for local Postgres,
# 'require' for cloud databases (default when DATABASE_URL is not used).
DB_SSLMODE=prefer

# ===== RENDER DEPLOYMENT =====
# Render auto-sets DATABASE_URL — no need to configure DB_* vars there.
# DATABASE_URL=postgres://user:password@host:port/dbname
# APP_KEY must be set on Render too, or magic links will fail.
# MAIL_PASSWORD must be set on Render (never commit secrets).

SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# ===== MAGIC LINK AUTH (passwordless) =====
# How long a magic link stays valid (seconds). Default 600 (10 min).
MAGIC_LINK_TTL=600
# Sender address shown on outgoing emails.
# IMPORTANT (Brevo): this MUST be a sender verified in your Brevo account
# (or a verified/authenticated domain), or Brevo silently rejects every send
# while the API still returns 200.
MAIL_FROM_ADDRESS=noreply@your_email.com
MAIL_FROM_NAME=your_blog_name

# Comma-separated admin emails notified when a new account is auto-provisioned
# via magic-link sign-in. Leave empty to disable.
ADMIN_NOTIFICATION_EMAILS=

# ===== SMTP (Brevo relay) =====
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=