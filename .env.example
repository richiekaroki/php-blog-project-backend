APP_NAME=Blog Backend
APP_ENV=local
# Required — used to sign magic links (HMAC-SHA256). Generate: base64 32 random bytes.
APP_KEY=
APP_DEBUG=true
# Base URL used to build magic link URLs. For Render: https://<your-service>.onrender.com
APP_URL=http://127.0.0.1

# ===== POSTGRESQL SETTINGS (local / Herd) =====
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mizzle_backend
DB_USERNAME=postgres
DB_PASSWORD=

# ===== RENDER DEPLOYMENT =====
# Render auto-sets DATABASE_URL — no need to configure DB_* vars there.
# DATABASE_URL=postgres://user:password@host:port/dbname
# APP_KEY must be set on Render too, or magic links will fail.
# MAIL_PASSWORD must be set on Render (never commit secrets).

SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# ===== MAGIC LINK AUTH (passwordless) =====
# How long a magic link stays valid (seconds). Default 900 (15 min).
MAGIC_LINK_TTL=900
# Sender address shown on outgoing emails
MAIL_FROM_ADDRESS=noreply@your_email.com
MAIL_FROM_NAME=your_blog_name

# ===== SMTP (Brevo relay) =====
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=