APP_NAME=Blog Backend
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1

# ===== POSTGRESQL SETTINGS (local) =====
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mizzle_backend
DB_USERNAME=postgres
DB_PASSWORD=

# ===== RENDER DEPLOYMENT =====
# Render auto-sets DATABASE_URL — no need to configure DB_* vars
# DATABASE_URL=postgres://user:password@host:port/dbname

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
